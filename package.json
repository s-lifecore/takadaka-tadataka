{
  "name": "takataka-tadataka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode prev",
    "build": "npm run typecheck && vite build",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,json,ts}\" \"functions/**/*.{ts,mjs,json}\" \"scripts/*.mjs\" \"!functions/node_modules/**\" \"!functions/lib/**\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,json,ts}\" \"functions/**/*.{ts,mjs,json}\" \"scripts/*.mjs\" \"!functions/node_modules/**\" \"!functions/lib/**\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "build:functions": "npm --prefix functions run build",
    "test:trail": "npm --prefix functions test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-trail-validation \"node scripts/firestore-rules.test.mjs && node functions/test/submitTrail.integration.mjs\""
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "dayjs": "^1.11.23",
    "dexie": "^4.0.10",
    "firebase": "^11.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
